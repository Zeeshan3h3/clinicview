# Sarvam AI API Configuration
SARVAM_API_KEY=your_sarvam_api_key_here

# Gemini Fallback (Optional, for OCR vision)
GEMINI_API_KEY=your_gemini_api_key_here

# Fast2SMS OTP Configuration (Optional, set to mock for testing)
OTP_PROVIDER=mock
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_OTP_TEMPLATE_ID=
FAST2SMS_SENDER_ID=
OTP_TEST_MODE=true
OTP_DISABLE_RATE_LIMIT=true
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=999
OTP_MAX_SENDS_PER_PHONE_WINDOW=99999
OTP_SEND_WINDOW_SECONDS=1
